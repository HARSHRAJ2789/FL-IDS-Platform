# Server
SECRET_KEY=change-this-to-a-long-random-string-in-production
DATABASE_URL=sqlite:////data/flds.db
WEIGHTS_DIR=/data/weights
MIN_CLIENTS_FOR_AGGREGATION=2
ROUND_AUTO_START=true

# Client Agent
FLDS_SERVER_URL=https://your-server.railway.app
FLDS_API_KEY=get-this-from-dashboard-after-registering
FLDS_INTERFACE=eth0
FLDS_CAPTURE_DURATION=300
FLDS_LOCAL_EPOCHS=3
FLDS_POLL_INTERVAL=60
